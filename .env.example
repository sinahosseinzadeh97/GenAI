# ================================
# QueryMind — Environment Config
# ================================
# Copy this file to .env and fill in your values:
# cp .env.example .env

# ----- Database -----
DB_PATH=data/querymind.db
DATABASE_TYPE=sqlite
# Options: sqlite | postgres
# Use sqlite for local dev, postgres for production + RAG mode

# ----- AI Providers -----
ANTHROPIC_API_KEY=your_anthropic_key_here
# Required for: SQL, agent, insights
# Get yours at: https://console.anthropic.com

OPENAI_API_KEY=your_openai_key_here
# Required for: RAG embeddings
# Get yours at: https://platform.openai.com

# ----- PostgreSQL (required for RAG Mode) -----
POSTGRES_DSN=postgresql://querymind:querymind_pass@localhost:5432/querymind
POSTGRES_READ_ONLY_DSN=postgresql://querymind_read:querymind_read_pass@localhost:5432/querymind
# Only needed if DATABASE_TYPE=postgres or using RAG Mode
# Used by SQL Mode to enforce read-only access at the database level

# ----- Redis -----
REDIS_URL=redis://redis:6379
# For local dev without docker: redis://localhost:6379

# ----- API Auth -----
QUERYMIND_API_KEY=your_secret_key_here

# ----- CORS -----
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ----- Models -----
EMBEDDING_MODEL=text-embedding-3-small
AGENT_MODEL=gpt-4o-mini

# ----- Logging -----
LOG_LEVEL=INFO

# Alembic migrations
# Run: alembic upgrade head

# Rate Limiting (requests per minute per IP)
RATE_LIMIT_QUERY=30/minute
RATE_LIMIT_RAG=20/minute
RATE_LIMIT_AGENT=20/minute
RATE_LIMIT_INGEST=5/minute

# ----- History Cleanup -----
HISTORY_RETENTION_DAYS=30
